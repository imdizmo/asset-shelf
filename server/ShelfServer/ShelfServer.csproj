<Project Sdk="Microsoft.NET.Sdk">
  <!-- The team's library service: serves the shared library and keeps the maps and props teammates publish. People are
       recognised by Tailscale; see README.md beside this file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShelfServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.5.0</Version>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
</Project>
