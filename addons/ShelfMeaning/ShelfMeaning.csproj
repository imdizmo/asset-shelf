<Project Sdk="Microsoft.NET.Sdk">
  <!-- shelf-meaning, an add-on for Asset Shelf: search by meaning with a model run on this computer (SigLIP 2 through
       ONNX Runtime). Installed on purpose, apart from Asset Shelf: only this program carries these libraries. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>shelf-meaning</AssemblyName>
    <RootNamespace>AssetShelf</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../app/Library.cs;../../app/Provenance.cs;../../app/Settings.cs;../../app/Team.cs;../../app/Log.cs;../../cli/Shelf/Shelves.cs" LinkBase="shared" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>
</Project>
