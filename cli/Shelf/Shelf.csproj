<Project Sdk="Microsoft.NET.Sdk">
  <!-- shelf: Asset Shelf from the command line (search, show, pull), for scripts and coding agents. It shares the app's
       library code (linked below) and needs no window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>shelf</AssemblyName>
    <RootNamespace>AssetShelf</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../app/Library.cs;../../app/Provenance.cs;../../app/Sender.cs;../../app/Run.cs;../../app/Settings.cs;../../app/Team.cs;../../app/Log.cs;../../app/Safety.cs" LinkBase="app" />
    <EmbeddedResource Include="../../skills/asset-shelf/SKILL.md" LogicalName="SKILL.md" />
  </ItemGroup>
</Project>
